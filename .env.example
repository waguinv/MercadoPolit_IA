# Valores fictícios. Nunca versionar credenciais reais.
APP_ENV=development
SECRET_KEY=change-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/mercadopilot
REDIS_URL=redis://localhost:6379/0

# Adaptador ERP: "mock" (padrão, todas as organizações usam dados simulados)
# ou "sysordem" (somente após homologação e autorização; cada organização usa o PRÓPRIO token,
# cadastrado por um admin via PUT /api/v1/erp/connection e guardado cifrado no banco).
ERP_ADAPTER=mock
# Obrigatória com ERP_ADAPTER=sysordem. Gere com: python scripts/generate_secrets_key.py
# Guarde fora do Git; trocar/perder a chave invalida os tokens já cifrados.
SECRETS_ENCRYPTION_KEY=
# A URL vem só daqui (nunca do cliente), para evitar SSRF. Valor do swagger oficial:
SYSORDEM_BASE_URL=https://api.meuerponline.com.br/publica
SYSORDEM_TIMEOUT_SECONDS=15
# Itens por página nas leituras (1..500). O swagger não documenta o máximo aceito.
SYSORDEM_PAGE_SIZE=100
