# Copie para .env.producao, nesta mesma pasta (o Git ignora esse arquivo) e deixe só root ler: chmod 600 .env.producao
# Valores fictícios. Nunca envie os reais por chat, e-mail ou Git.

# Gere cada um com: openssl rand -hex 32
SECRET_KEY=troque-por-um-valor-gerado
# Só letras e números: entra na URL de conexão. Trocar depois da instalação exige alterar também dentro do banco.
POSTGRES_PASSWORD=troque-por-um-valor-gerado

# Porta local do backend, só para o nginx. Precisa estar livre e igual à de infra/nginx/gestor.conf.
BACKEND_PORT=8011
# Um por CPU livre. O servidor provisório tem 1 CPU, compartilhada com outros sistemas.
BACKEND_WORKERS=1

# "mock" = dados fictícios, sem acesso ao ERP. Use "sysordem" só depois da homologação e com autorização.
ERP_ADAPTER=mock
# Obrigatória com sysordem: python scripts/generate_secrets_key.py. Guarde uma cópia à parte: perder invalida os tokens.
SECRETS_ENCRYPTION_KEY=
SYSORDEM_BASE_URL=https://api.meuerponline.com.br/publica
